#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) uniform MatcherParams {
    ivec4 sizes;
    ivec4 options;
    vec4 thresholdsCamera;
    vec4 cameraImage;
    vec4 Twc1Rows[3];
    vec4 Twc2Rows[3];
    vec4 Tcw2Rows[3];
    vec4 fundamentalRows[3];
} params;

layout(std430, set = 0, binding = 1) readonly buffer Keypoints1 { float values[]; } keypoints1;
layout(std430, set = 0, binding = 2) readonly buffer Descriptors1 { uint values[]; } descs1;
layout(std430, set = 0, binding = 3) readonly buffer Descriptors2 { uint values[]; } descs2;
layout(std430, set = 0, binding = 4) readonly buffer CameraPoints1 { float values[]; } pcs1;
layout(std430, set = 0, binding = 5) readonly buffer CameraPoints2 { float values[]; } pcs2;
layout(std430, set = 0, binding = 6) readonly buffer FeatureGrid { int values[]; } featureGrid;
layout(std430, set = 0, binding = 7) readonly buffer FeatureGridSizes { int values[]; } featureGridSizes;
layout(std430, set = 0, binding = 8) writeonly buffer Matches { int values[]; } matches;

vec3 point1(int index)
{
    int offset = index * 3;
    return vec3(pcs1.values[offset], pcs1.values[offset + 1], pcs1.values[offset + 2]);
}

vec3 point2(int index)
{
    int offset = index * 3;
    return vec3(pcs2.values[offset], pcs2.values[offset + 1], pcs2.values[offset + 2]);
}

vec3 transformPoint(vec4 rows[3], vec3 point)
{
    vec4 homogeneous = vec4(point, 1.0);
    return vec3(dot(rows[0], homogeneous), dot(rows[1], homogeneous), dot(rows[2], homogeneous));
}

int descriptorDistance(int index1, int index2)
{
    int distance = 0;
    int offset1 = index1 * 8;
    int offset2 = index2 * 8;
    for (int word = 0; word < 8; ++word)
        distance += bitCount(descs1.values[offset1 + word] ^ descs2.values[offset2 + word]);
    return distance;
}

bool valid3DPair(int index1, int index2)
{
    if (params.options.z == 0)
        return true;
    vec3 cameraPoint1 = point1(index1);
    vec3 cameraPoint2 = point2(index2);
    if (cameraPoint1.z <= 0.0 || cameraPoint2.z <= 0.0)
        return false;
    vec3 worldPoint1 = transformPoint(params.Twc1Rows, cameraPoint1);
    vec3 worldPoint2 = transformPoint(params.Twc2Rows, cameraPoint2);
    vec3 delta = worldPoint1 - worldPoint2;
    return dot(delta, delta) <= params.thresholdsCamera.y;
}

void testCell(int column, int row, int index1, inout int bestIndex,
    inout int bestDistance, inout int nextDistance)
{
    int activeWidth = min(params.sizes.z, int(ceil(params.cameraImage.z / float(params.options.x))));
    int activeHeight = min(params.sizes.w, int(ceil(params.cameraImage.w / float(params.options.x))));
    if (column < 0 || row < 0 || column >= activeWidth || row >= activeHeight)
        return;
    int cell = row * params.sizes.z + column;
    int count = clamp(featureGridSizes.values[cell], 0, 128);
    int begin = cell * 128;
    for (int k = 0; k < count; ++k) {
        int index2 = featureGrid.values[begin + k];
        if (index2 < 0 || index2 >= params.sizes.y || !valid3DPair(index1, index2))
            continue;
        int distance = descriptorDistance(index1, index2);
        if (distance > params.options.y)
            continue;
        if (distance < bestDistance) {
            nextDistance = bestDistance;
            bestDistance = distance;
            bestIndex = index2;
        }
        else if (distance < nextDistance) {
            nextDistance = distance;
        }
    }
}

void main()
{
    int index1 = int(gl_GlobalInvocationID.x);
    if (index1 >= params.sizes.x)
        return;
    matches.values[index1] = -1;
    if (params.options.z == 1 && point1(index1).z <= 0.0)
        return;

    vec2 keypoint = vec2(keypoints1.values[index1 * 2], keypoints1.values[index1 * 2 + 1]);
    vec3 homogeneous = vec3(keypoint, 1.0);
    vec3 line = vec3(dot(params.fundamentalRows[0].xyz, homogeneous),
        dot(params.fundamentalRows[1].xyz, homogeneous),
        dot(params.fundamentalRows[2].xyz, homogeneous));
    if (dot(line.xy, line.xy) < 1e-12)
        return;

    int bestIndex = -1;
    int bestDistance = 257;
    int nextDistance = 257;
    int resolution = params.options.x;
    int activeWidth = min(params.sizes.z, int(ceil(params.cameraImage.z / float(resolution))));
    int activeHeight = min(params.sizes.w, int(ceil(params.cameraImage.w / float(resolution))));

    if (abs(line.x) >= abs(line.y)) {
        for (int row = 0; row < activeHeight; ++row) {
            float y = (float(row) + 0.5) * float(resolution);
            float x = -(line.y * y + line.z) / line.x;
            float gridColumn = x / float(resolution);
            int column = int(floor(gridColumn));
            testCell(column, row, index1, bestIndex, bestDistance, nextDistance);
            float boundary = round(gridColumn);
            if (abs(gridColumn - boundary) < 1e-4) {
                int adjacentColumn = gridColumn < boundary ? int(boundary) : int(boundary) - 1;
                if (adjacentColumn != column)
                    testCell(adjacentColumn, row, index1, bestIndex, bestDistance, nextDistance);
            }
        }
    }
    else {
        for (int column = 0; column < activeWidth; ++column) {
            float x = (float(column) + 0.5) * float(resolution);
            float y = -(line.x * x + line.z) / line.y;
            float gridRow = y / float(resolution);
            int row = int(floor(gridRow));
            testCell(column, row, index1, bestIndex, bestDistance, nextDistance);
            float boundary = round(gridRow);
            if (abs(gridRow - boundary) < 1e-4) {
                int adjacentRow = gridRow < boundary ? int(boundary) : int(boundary) - 1;
                if (adjacentRow != row)
                    testCell(column, adjacentRow, index1, bestIndex, bestDistance, nextDistance);
            }
        }
    }

    if (bestIndex < 0 || float(bestDistance) > float(nextDistance) * params.thresholdsCamera.x)
        return;
    matches.values[index1] = bestIndex;
}
